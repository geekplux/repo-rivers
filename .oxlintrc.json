{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest", "unicorn"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectRejects"] }],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [{ "files": ["scripts/**/*.mjs", "scripts/**/*.ts", "vite.config.ts"], "env": { "node": true } }],
  "ignorePatterns": ["dist", "node_modules", "docs/screenshots", "docs/redesign/target", ".wrangler"]
}
