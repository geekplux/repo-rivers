{
  "name": "repo-rivers",
  "version": "0.0.0",
  "private": true,
  "description": "See a GitHub repository's history as rivers of modules and contributors.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev -c wrangler.dev.jsonc --port 8787",
    "build": "vite build",
    "size": "node scripts/size-check.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "types:worker": "wrangler types -c wrangler.jsonc",
    "test": "vitest run",
    "check:browser": "node scripts/browser/run.mjs",
    "gallery": "node scripts/browser/run.mjs --gallery",
    "check:worker": "node scripts/worker-smoke.mjs",
    "samples:build": "node scripts/build-samples.ts",
    "eras:build": "node scripts/build-eras.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  }
}
