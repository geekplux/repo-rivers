// Local-dev copy of wrangler.jsonc (`pnpm dev:worker`), identical except that it has no `ai` binding (and no `previews` block,
// which only `wrangler preview` reads): Workers AI
// has no local mode, and the binding would open a remote session with whatever Cloudflare credentials are around.
// Without it, /api/health reports `ai: false` and /api/eras answers with heuristic names. Keep the rest in sync
// with wrangler.jsonc (scripts/wrangler-config.test.ts checks this). Types come from wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-rivers",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "RIVERS_KV",
      "id": "e15b4e2e25d64a9fa1ae087ef86d8a0b"
    }
  ],
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
  // Optional secret: GITHUB_TOKEN in .dev.vars (never in this file).
}
