// Cloudflare Worker: the /api/* routes plus the built SPA from ./dist (docs/PLAN.md §4.5).
// Deploy config; local dev (`pnpm build && pnpm dev:worker`) uses wrangler.dev.jsonc. Steps, the exact deploy
// command and rollback: docs/DEPLOY.md. `pnpm run check:deploy` is a dry run that uploads nothing.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-rivers",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "RIVERS_KV",
      // Production namespace from `wrangler kv namespace create RIVERS_KV`. Forks: replace it with your
      // own 32-hex id before deploying (docs/DEPLOY.md). Local dev simulates KV and ignores the id.
      "id": "e15b4e2e25d64a9fa1ae087ef86d8a0b"
    }
  ],
  // About 20 requests per minute per client IP on /api/*.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Workers AI names eras (POST /api/eras). Local dev uses wrangler.dev.jsonc, which has no `ai` binding, so
  // `pnpm dev:worker` never contacts Cloudflare and the route answers with heuristic names.
  "ai": { "binding": "AI" },
  // Workers Logs for the deployed Worker (no effect locally).
  "observability": { "enabled": true },
  // PR Preview deployments (`wrangler preview`, run by Workers Builds on PRs). Previews inherit no bindings, so
  // this lists what Previews get. No RIVERS_KV on purpose: without it the Worker skips the cache (every request
  // is a miss, nothing is written), so a Preview never reads or writes production entries. Its own rate-limit
  // namespace (1102) keeps Preview traffic off production's counters. GITHUB_TOKEN is not shared either.
  "previews": {
    "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } }],
    "ai": { "binding": "AI" }
  }
  // Optional secret (never in this file): `wrangler secret put GITHUB_TOKEN`; locally in .dev.vars.
}
