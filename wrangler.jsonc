// Cloudflare Worker: the /api/* routes plus the built SPA from ./dist (docs/PLAN.md §4.5).
// Local dev: `pnpm build && pnpm dev:worker`. Never deploy without Sean's approval (phase 12).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-rivers",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "RIVERS_KV",
      // Placeholders: create the namespace and paste its ids before deploying (phase 12).
      "id": "00000000000000000000000000000000-placeholder",
      "preview_id": "00000000000000000000000000000000-preview"
    }
  ],
  // About 20 requests per minute per client IP on /api/*.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
  // Optional secret (never in this file): `wrangler secret put GITHUB_TOKEN`; locally in .dev.vars.
}
